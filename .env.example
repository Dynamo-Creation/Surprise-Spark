# ==============================================================================
# SURPRISESPARK - ENVIRONMENT CONFIGURATION (PHASE 1)
# Copy this file to .env.local for local development.
# DO NOT commit real production secrets to version control.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Prepared for Future Phases)
# ------------------------------------------------------------------------------
# Public Supabase URL (safe for browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anonymous Key (safe for browser client, RLS protected)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Service Role Secret (NEVER expose to client code / browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3D ASSETS & STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORAGE_BUCKET_EXPERIENCES=experiences
NEXT_PUBLIC_STORAGE_BUCKET_AUDIO=audio
NEXT_PUBLIC_STORAGE_BUCKET_ASSETS3D=assets3d
